# ==============================================================================
# Cashflow Lifeline - Production & Sandbox Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real secrets.
# NEVER commit your actual .env file containing live secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Sandbox Configuration
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. LLM / AI Configuration (options: template | anthropic | gemini)
# ------------------------------------------------------------------------------
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Security, Guardrails & Token Cryptography
# Note: In production (DEV_MODE=false), both APPROVAL_SECRET and JWT_SECRET
# MUST be unique, random strings of at least 32 characters.
# ------------------------------------------------------------------------------
APPROVAL_SECRET=change-this-to-a-secure-random-32-byte-secret-key-1234
JWT_SECRET=change-this-to-a-secure-jwt-signing-secret-key-5678
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Multi-Channel Phone Authentication & SMS OTP
# ------------------------------------------------------------------------------
SMS_PROVIDER=console # options: console | twilio | msg91 | exotel
SMS_ENABLED=true
SMS_OTP_EXPIRE_MINUTES=5
SMS_RESEND_COOLDOWN_SECONDS=60
DEFAULT_COUNTRY_DIAL_CODE=+91

# SMS Provider Credentials (Twilio / MSG91 / Exotel)
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 5. Email Verification & Password Reset OTP System
# ------------------------------------------------------------------------------
OTP_PEPPER=change-this-to-a-cryptographically-secure-otp-pepper-9012
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRE_MINUTES=15

# Email Dispatch Configuration (options: console | smtp | resend | sendgrid)
EMAIL_PROVIDER=console
EMAIL_FROM=Cashflow Lifeline <no-reply@cashflowlifeline.com>
EMAIL_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

# ------------------------------------------------------------------------------
# 6. Google OAuth 2.0 / OpenID Connect
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# ------------------------------------------------------------------------------
# 7. Database Configuration
# ------------------------------------------------------------------------------
# Local dev default (SQLite):
DATABASE_URL=sqlite:///./cashflow.db
# Docker compose / MySQL 8:
# DATABASE_URL=mysql+pymysql://cashflow_user:cashflow_password@mysql:3306/cashflow_lifeline?charset=utf8mb4

# Docker & MySQL Service Secrets
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cashflow_lifeline
MYSQL_USER=cashflow_user
MYSQL_PASSWORD=cashflow_password

# ------------------------------------------------------------------------------
# 8. Server, Port & Worker Settings
# ------------------------------------------------------------------------------
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=80
BACKEND_WORKERS=2
DEV_MODE=true

# Policy Guardrails
MAX_DISCOUNT_PCT=5.0
MAX_PAYOUT_AMOUNT=10000.0
ALLOWED_CURRENCIES=USD,EUR,GBP,CAD,AUD,JPY,INR,SGD,AED,CHF,BRL,MXN,NZD,SEK
