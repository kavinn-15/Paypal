# PayPal Sandbox Configuration
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Configuration (options: template | anthropic | gemini)
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Security & Guardrail
APPROVAL_SECRET=change-this-to-a-secure-random-32-byte-secret-key-1234
JWT_SECRET=change-this-to-a-secure-jwt-signing-secret-key-5678
PUBLIC_BASE_URL=http://localhost:8000

# Database Configuration (MySQL 8 for production/Docker; SQLite for lightweight local dev/tests)
# DATABASE_URL=mysql+pymysql://cashflow_user:cashflow_password@localhost:3306/cashflow_lifeline?charset=utf8mb4
DATABASE_URL=sqlite:///./cashflow.db

# Policy Controls
MAX_DISCOUNT_PCT=5.0
MAX_PAYOUT_AMOUNT=10000.0
ALLOWED_CURRENCIES=USD,EUR,GBP,CAD
DEV_MODE=true
PORT=8000
